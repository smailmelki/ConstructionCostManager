@page "/phases"
@inject IConstructionCostService CostService
@inject ActiveProjectState ProjectState
@implements IDisposable

<PageTitle>مراحل البناء - مدير تكاليف البناء</PageTitle>

@if (ProjectState.ActiveProject is null)
{
    <div class="fin-card text-center py-4">يرجى إنشاء أو اختيار مشروع أولاً من صفحة <a href="/projects">المشاريع</a>.</div>
}
else
{
    var cur = ProjectState.ActiveProject.CurrencyCode;

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="fw-bold mb-0">مراحل البناء وتصنيف التكاليف</h4>
        <button class="btn btn-primary" @onclick="StartAdd">+ إضافة مرحلة جديدة</button>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert @(_isError ? "alert-danger" : "alert-success") py-2">@_message</div>
    }

    @if (_showForm)
    {
        <div class="fin-card mb-4">
            <h6 class="fw-bold mb-3">@(_editing.Id == 0 ? "إضافة مرحلة بناء" : "تعديل المرحلة")</h6>
            <div class="row g-3">
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">الترتيب</label>
                    <input type="number" class="form-control" @bind="_editing.DisplayOrder" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small fw-semibold">اسم المرحلة *</label>
                    <input class="form-control" @bind="_editing.Name" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">الوصف</label>
                    <input class="form-control" @bind="_editing.Description" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SaveAsync">حفظ</button>
                <button class="btn btn-outline-secondary" @onclick="() => _showForm = false">إلغاء</button>
            </div>
        </div>
    }

    <div class="fin-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم المرحلة</th>
                        <th>المواد</th>
                        <th>العمال</th>
                        <th>النقل والمعدات</th>
                        <th>الإجمالي</th>
                        <th>إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ph in _phases)
                    {
                        var stats = _summary?.PhaseSummaries.FirstOrDefault(s => s.PhaseId == ph.Id);
                        <tr>
                            <td>@ph.DisplayOrder</td>
                            <td>
                                <div class="fw-semibold">@ph.Name</div>
                                @if (!string.IsNullOrWhiteSpace(ph.Description))
                                {
                                    <div class="small text-secondary">@ph.Description</div>
                                }
                            </td>
                            <td class="money-num">@ArabicDisplayHelper.FormatMoney(stats?.MaterialsCost ?? 0m, cur)</td>
                            <td class="money-num">@ArabicDisplayHelper.FormatMoney(stats?.LaborCost ?? 0m, cur)</td>
                            <td class="money-num">@ArabicDisplayHelper.FormatMoney(stats?.TransportAndOtherCost ?? 0m, cur)</td>
                            <td class="money-num fw-bold">@ArabicDisplayHelper.FormatMoney(stats?.TotalCost ?? 0m, cur)</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary me-1" @onclick="() => EditPhase(ph)">تعديل</button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePhaseAsync(ph.Id)">حذف</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<ConstructionPhase> _phases = new();
    private ProjectFinancialSummary? _summary;
    private ConstructionPhase _editing = new();
    private bool _showForm;
    private string? _message;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        ProjectState.OnChange += HandleProjectChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!ProjectState.ActiveProjectId.HasValue) return;
        var pid = ProjectState.ActiveProjectId.Value;
        _phases = await CostService.GetPhasesAsync(pid);
        _summary = await CostService.GetProjectFinancialSummaryAsync(pid);
    }

    private void StartAdd()
    {
        _editing = new ConstructionPhase
        {
            ProjectId = ProjectState.ActiveProjectId ?? 0,
            DisplayOrder = (_phases.LastOrDefault()?.DisplayOrder ?? 0) + 1
        };
        _showForm = true;
        _message = null;
    }

    private void EditPhase(ConstructionPhase ph)
    {
        _editing = new ConstructionPhase
        {
            Id = ph.Id,
            ProjectId = ph.ProjectId,
            DisplayOrder = ph.DisplayOrder,
            Name = ph.Name,
            Description = ph.Description
        };
        _showForm = true;
        _message = null;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editing.Name)) return;
        if (_editing.Id == 0)
            await CostService.AddPhaseAsync(_editing);
        else
            await CostService.UpdatePhaseAsync(_editing);

        _showForm = false;
        _isError = false;
        _message = "تم حفظ المرحلة بنجاح.";
        await LoadAsync();
    }

    private async Task DeletePhaseAsync(int id)
    {
        var (ok, err) = await CostService.DeletePhaseAsync(id);
        _isError = !ok;
        _message = ok ? "تم حذف المرحلة." : err;
        await LoadAsync();
    }

    private async void HandleProjectChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ProjectState.OnChange -= HandleProjectChanged;
}
