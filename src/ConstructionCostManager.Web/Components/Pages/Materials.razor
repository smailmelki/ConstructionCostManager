@page "/materials"
@inject IConstructionCostService CostService
@inject ActiveProjectState ProjectState
@implements IDisposable

<PageTitle>مواد البناء - مدير تكاليف البناء</PageTitle>

@if (ProjectState.ActiveProject is null)
{
    <div class="fin-card text-center py-4">يرجى إنشاء أو اختيار مشروع أولاً من صفحة <a href="/projects">المشاريع</a>.</div>
}
else
{
    var cur = ProjectState.ActiveProject.CurrencyCode;

    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h4 class="fw-bold mb-0">تسجيل مشتريات مواد البناء</h4>
        <button class="btn btn-primary" @onclick="ToggleForm">@(_showForm ? "إغلاق النموذج" : "+ تسجيل فاتورة شراء جديدة")</button>
    </div>

    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert alert-info py-2">@_statusMessage</div>
    }

    @if (_showForm)
    {
        <div class="fin-card mb-4">
            <h6 class="fw-bold mb-3">بيانات عملية الشراء (يمكن إضافة عدة مواد في فاتورة واحدة)</h6>
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">المرحلة *</label>
                    <select class="form-select" @bind="_newPurchase.PhaseId">
                        @foreach (var ph in _phases)
                        {
                            <option value="@ph.Id">@ph.DisplayOrder. @ph.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">اسم المورد</label>
                    <input class="form-control" @bind="_newPurchase.SupplierName" placeholder="المورد أو المحل" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">رقم الفاتورة</label>
                    <input class="form-control" @bind="_newPurchase.InvoiceNumber" placeholder="FAC-..." />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">تاريخ الشراء</label>
                    <input type="date" class="form-control" @bind="_newPurchase.PurchaseDate" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-semibold">تكاليف النقل</label>
                    <input type="number" step="0.01" class="form-control" @bind="_newPurchase.TransportCost" />
                </div>
            </div>

            <div class="border rounded p-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold small">قائمة المواد المشتراة</span>
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddItemRow">+ إضافة مادة أخرى</button>
                </div>

                @for (int i = 0; i < _items.Count; i++)
                {
                    var item = _items[i];
                    var idx = i;
                    <div class="row g-2 align-items-end mb-2 pb-2 border-bottom">
                        <div class="col-md-3">
                            <label class="form-label small">اسم المادة *</label>
                            <input class="form-control form-control-sm" @bind="item.Name" placeholder="مثال: إسمنت" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">التصنيف</label>
                            <select class="form-select form-select-sm" @bind="item.Category">
                                @foreach (var cat in Enum.GetValues<MaterialCategory>())
                                {
                                    <option value="@cat">@ArabicDisplayHelper.GetMaterialCategoryLabel(cat)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">الكمية</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="item.Quantity" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">الوحدة</label>
                            <select class="form-select form-select-sm" @bind="item.Unit">
                                @foreach (var u in Enum.GetValues<MeasurementUnit>())
                                {
                                    <option value="@u">@ArabicDisplayHelper.GetUnitLabel(u)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">سعر الوحدة</label>
                            <input type="number" step="0.01" class="form-control form-control-sm" @bind="item.UnitPrice" />
                        </div>
                        <div class="col-md-1">
                            <label class="form-label small">الإجمالي</label>
                            <div class="fw-bold small money-num py-1">@item.TotalAmount.ToString("N2")</div>
                        </div>
                        <div class="col-md-1 text-end">
                            @if (_items.Count > 1)
                            {
                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => _items.RemoveAt(idx)">✕</button>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">المبلغ المدفوع الآن</label>
                    <input type="number" step="0.01" class="form-control" @bind="_initialPaid" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">طريقة الدفع</label>
                    <select class="form-select" @bind="_paymentMethod">
                        @foreach (var m in Enum.GetValues<PaymentMethod>())
                        {
                            <option value="@m">@ArabicDisplayHelper.GetPaymentMethodLabel(m)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">ملاحظات</label>
                    <input class="form-control" @bind="_newPurchase.Notes" />
                </div>
                <div class="col-md-3 text-end">
                    @{
                        var grandTotal = _items.Sum(x => x.TotalAmount) + _newPurchase.TransportCost;
                    }
                    <div class="small text-secondary">الإجمالي الكلي للفاتورة:</div>
                    <div class="fs-5 fw-bold text-primary money-num">@ArabicDisplayHelper.FormatMoney(grandTotal, cur)</div>
                </div>
            </div>

            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="SavePurchaseAsync">حفظ الفاتورة</button>
                <button class="btn btn-outline-secondary" @onclick="() => _showForm = false">إلغاء</button>
            </div>
        </div>
    }

    <div class="fin-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>الفاتورة / المورد</th>
                        <th>المرحلة</th>
                        <th>المواد</th>
                        <th>النقل</th>
                        <th>الإجمالي</th>
                        <th>إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_purchases.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-secondary py-4">لا توجد مشتريات مواد مسجلة لهذا المشروع.</td></tr>
                    }
                    else
                    {
                        @foreach (var p in _purchases)
                        {
                            <tr>
                                <td>@p.PurchaseDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(p.SupplierName) ? "مورد غير محدد" : p.SupplierName)</div>
                                    @if (!string.IsNullOrWhiteSpace(p.InvoiceNumber))
                                    {
                                        <div class="small text-secondary">فاتورة #@p.InvoiceNumber</div>
                                    }
                                </td>
                                <td>@(p.Phase?.Name ?? "-")</td>
                                <td>
                                    @foreach (var it in p.Items)
                                    {
                                        <div class="small">
                                            • <strong>@it.Name</strong> (@it.Quantity.ToString("N2") @ArabicDisplayHelper.GetUnitLabel(it.Unit) × @it.UnitPrice.ToString("N2")) = <span class="money-num">@ArabicDisplayHelper.FormatMoney(it.TotalAmount, cur)</span>
                                        </div>
                                    }
                                </td>
                                <td class="money-num">@ArabicDisplayHelper.FormatMoney(p.TransportCost, cur)</td>
                                <td class="money-num fw-bold">@ArabicDisplayHelper.FormatMoney(p.TotalAmount, cur)</td>
                                <td>
                                    @if (_confirmDeleteId == p.Id)
                                    {
                                        <button class="btn btn-sm btn-danger me-1" @onclick="() => DeletePurchaseAsync(p.Id)">تأكيد الحذف</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeleteId = null">إلغاء</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDeleteId = p.Id">حذف</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<ConstructionPhase> _phases = new();
    private List<MaterialPurchase> _purchases = new();
    private MaterialPurchase _newPurchase = new();
    private List<MaterialItem> _items = new();
    private decimal _initialPaid;
    private PaymentMethod _paymentMethod = PaymentMethod.Cash;
    private bool _showForm;
    private int? _confirmDeleteId;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        ProjectState.OnChange += HandleProjectChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!ProjectState.ActiveProjectId.HasValue) return;
        var pid = ProjectState.ActiveProjectId.Value;
        _phases = await CostService.GetPhasesAsync(pid);
        _purchases = await CostService.GetMaterialPurchasesAsync(pid);
    }

    private void ToggleForm()
    {
        _showForm = !_showForm;
        if (_showForm && ProjectState.ActiveProjectId.HasValue)
        {
            _newPurchase = new MaterialPurchase
            {
                ProjectId = ProjectState.ActiveProjectId.Value,
                PhaseId = _phases.FirstOrDefault()?.Id ?? 0,
                PurchaseDate = DateTime.Today
            };
            _items = new List<MaterialItem> { new() { Quantity = 1 } };
            _initialPaid = 0m;
            _statusMessage = null;
        }
    }

    private void AddItemRow() => _items.Add(new MaterialItem { Quantity = 1 });

    private async Task SavePurchaseAsync()
    {
        var validItems = _items.Where(i => !string.IsNullOrWhiteSpace(i.Name) && i.Quantity > 0).ToList();
        if (validItems.Count == 0 || _newPurchase.PhaseId == 0)
        {
            _statusMessage = "يرجى إدخال مادة واحدة على الأقل مع تحديد المرحلة.";
            return;
        }

        _newPurchase.Items = validItems;
        await CostService.AddMaterialPurchaseAsync(_newPurchase, _initialPaid, _paymentMethod);
        _showForm = false;
        _statusMessage = "تم حفظ فاتورة المواد وتحديث التكاليف بنجاح.";
        await LoadAsync();
    }

    private async Task DeletePurchaseAsync(int id)
    {
        await CostService.SoftDeleteMaterialPurchaseAsync(id);
        _confirmDeleteId = null;
        _statusMessage = "تم حذف السجل المالي بأمان.";
        await LoadAsync();
    }

    private async void HandleProjectChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ProjectState.OnChange -= HandleProjectChanged;
}
