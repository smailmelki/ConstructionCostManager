@page "/projects"
@inject IConstructionCostService CostService
@inject ActiveProjectState ProjectState

<PageTitle>إدارة المشاريع - مدير تكاليف البناء</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="fw-bold mb-0">إدارة مشاريع البناء</h4>
    <button class="btn btn-primary" @onclick="StartNewProject">+ إضافة مشروع جديد</button>
</div>

@if (!string.IsNullOrEmpty(_message))
{
    <div class="alert alert-success py-2">@_message</div>
}

@if (_showForm)
{
    <div class="fin-card mb-4">
        <h6 class="fw-bold mb-3">@(_editing.Id == 0 ? "إنشاء مشروع جديد" : $"تعديل مشروع: {_editing.Name}")</h6>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label small fw-semibold">اسم المشروع *</label>
                <input class="form-control" @bind="_editing.Name" placeholder="مثال: بناء فيلا سكنية" />
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-semibold">اسم صاحب المشروع</label>
                <input class="form-control" @bind="_editing.OwnerName" placeholder="الاسم الكامل للمالك" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">موقع المشروع</label>
                <input class="form-control" @bind="_editing.Location" placeholder="الولاية / المدينة" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">تاريخ البداية</label>
                <input type="date" class="form-control" @bind="_editing.StartDate" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">الحالة</label>
                <select class="form-select" @bind="_editing.Status">
                    @foreach (var s in Enum.GetValues<ProjectStatus>())
                    {
                        <option value="@s">@ArabicDisplayHelper.GetStatusLabel(s)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">الميزانية التقديرية</label>
                <input type="number" step="0.01" class="form-control" @bind="_editing.EstimatedBudget" />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-semibold">العملة</label>
                <select class="form-select" @bind="_editing.CurrencyCode">
                    <option value="DZD">الدينار الجزائري (DZD)</option>
                    <option value="SAR">الريال السعودي (SAR)</option>
                    <option value="MAD">الدرهم المغربي (MAD)</option>
                    <option value="TND">الدينار التونسي (TND)</option>
                    <option value="AED">الدرهم الإماراتي (AED)</option>
                    <option value="EGP">الجنيه المصري (EGP)</option>
                    <option value="USD">الدولار الأمريكي (USD)</option>
                    <option value="EUR">اليورو (EUR)</option>
                </select>
            </div>
            <div class="col-12">
                <label class="form-label small fw-semibold">وصف المشروع</label>
                <textarea class="form-control" rows="2" @bind="_editing.Description"></textarea>
            </div>
        </div>
        <div class="d-flex gap-2 mt-3">
            <button class="btn btn-primary" @onclick="SaveProjectAsync">حفظ المشروع</button>
            <button class="btn btn-outline-secondary" @onclick="() => _showForm = false">إلغاء</button>
        </div>
    </div>
}

<div class="row g-3">
    @foreach (var p in _projects)
    {
        var isActive = ProjectState.ActiveProjectId == p.Id;
        <div class="col-md-6 col-xl-4">
            <div class="fin-card h-100 d-flex flex-column justify-content-between @(isActive ? "border-primary border-2" : "")">
                <div>
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h6 class="fw-bold mb-0">@p.Name</h6>
                        <span class="badge @(p.Status == ProjectStatus.Completed ? "badge-soft-success" : p.Status == ProjectStatus.Paused ? "badge-soft-warning" : "bg-primary bg-opacity-10 text-primary")">
                            @ArabicDisplayHelper.GetStatusLabel(p.Status)
                        </span>
                    </div>
                    <div class="small text-secondary mb-1">المالك: @(string.IsNullOrWhiteSpace(p.OwnerName) ? "-" : p.OwnerName)</div>
                    <div class="small text-secondary mb-1">الموقع: @(string.IsNullOrWhiteSpace(p.Location) ? "-" : p.Location)</div>
                    <div class="small text-secondary mb-2">البداية: @p.StartDate.ToString("yyyy-MM-dd")</div>
                    <div class="fw-bold money-num mb-2">الميزانية: @ArabicDisplayHelper.FormatMoney(p.EstimatedBudget, p.CurrencyCode)</div>
                    @if (!string.IsNullOrWhiteSpace(p.Description))
                    {
                        <p class="small text-secondary mb-2">@p.Description</p>
                    }
                </div>
                <div class="d-flex gap-2 pt-2 border-top">
                    @if (!isActive)
                    {
                        <button class="btn btn-sm btn-primary flex-grow-1" @onclick="() => SelectProjectAsync(p.Id)">تفعيل المشروع</button>
                    }
                    else
                    {
                        <span class="btn btn-sm btn-success disabled flex-grow-1">✓ المشروع النشط</span>
                    }
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditProject(p)">تعديل</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<Project> _projects = new();
    private Project _editing = new();
    private bool _showForm;
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _projects = await CostService.GetProjectsAsync();
    }

    private void StartNewProject()
    {
        _editing = new Project { StartDate = DateTime.Today, CurrencyCode = "DZD" };
        _showForm = true;
        _message = null;
    }

    private void EditProject(Project p)
    {
        _editing = new Project
        {
            Id = p.Id,
            Name = p.Name,
            OwnerName = p.OwnerName,
            Location = p.Location,
            StartDate = p.StartDate,
            EstimatedBudget = p.EstimatedBudget,
            Description = p.Description,
            Status = p.Status,
            CurrencyCode = p.CurrencyCode
        };
        _showForm = true;
        _message = null;
    }

    private async Task SaveProjectAsync()
    {
        if (string.IsNullOrWhiteSpace(_editing.Name)) return;

        if (_editing.Id == 0)
        {
            var created = await CostService.CreateProjectAsync(_editing);
            await ProjectState.SetActiveProjectAsync(CostService, created.Id);
            _message = "تم إنشاء المشروع وتجهيز مراحل البناء الافتراضية بنجاح.";
        }
        else
        {
            await CostService.UpdateProjectAsync(_editing);
            ProjectState.NotifyChanged();
            _message = "تم تحديث بيانات المشروع بنجاح.";
        }

        _showForm = false;
        await LoadAsync();
    }

    private async Task SelectProjectAsync(int id)
    {
        await ProjectState.SetActiveProjectAsync(CostService, id);
    }
}
