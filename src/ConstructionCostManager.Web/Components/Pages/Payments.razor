@page "/payments"
@inject IConstructionCostService CostService
@inject ActiveProjectState ProjectState
@implements IDisposable

<PageTitle>المدفوعات والديون - مدير تكاليف البناء</PageTitle>

@if (ProjectState.ActiveProject is null || _summary is null)
{
    <div class="fin-card text-center py-4">يرجى إنشاء أو اختيار مشروع أولاً من صفحة <a href="/projects">المشاريع</a>.</div>
}
else
{
    var cur = _summary.CurrencyCode;

    <h4 class="fw-bold mb-3">إدارة المدفوعات والديون والالتزامات المالية</h4>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="fin-card">
                <div class="kpi-label">إجمالي التكاليف المستحقة</div>
                <div class="kpi-value">@ArabicDisplayHelper.FormatMoney(_summary.TotalAccruedCost, cur)</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="fin-card">
                <div class="kpi-label">إجمالي المبالغ المدفوعة (التدفق النقدي)</div>
                <div class="kpi-value text-success">@ArabicDisplayHelper.FormatMoney(_summary.TotalPaid, cur)</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="fin-card">
                <div class="kpi-label">الديون والمبالغ المتبقية (الالتزامات)</div>
                <div class="kpi-value text-danger">@ArabicDisplayHelper.FormatMoney(_summary.TotalRemainingDebt, cur)</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_message))
    {
        <div class="alert alert-success py-2">@_message</div>
    }

    @if (_payingObligation is not null)
    {
        <div class="fin-card mb-4 border-primary border-2">
            <h6 class="fw-bold mb-3">تسجيل دفعة جديدة: @_payingObligation.Title (@_payingObligation.PartyName)</h6>
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">المبلغ المتبقي</label>
                    <input class="form-control" readonly value="@ArabicDisplayHelper.FormatMoney(_payingObligation.RemainingAmount, cur)" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">مبلغ الدفعة *</label>
                    <input type="number" step="0.01" class="form-control" @bind="_newPayment.Amount" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">تاريخ الدفعة</label>
                    <input type="date" class="form-control" @bind="_newPayment.PaymentDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-semibold">طريقة الدفع</label>
                    <select class="form-select" @bind="_newPayment.Method">
                        @foreach (var m in Enum.GetValues<PaymentMethod>())
                        {
                            <option value="@m">@ArabicDisplayHelper.GetPaymentMethodLabel(m)</option>
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label small fw-semibold">ملاحظات</label>
                    <input class="form-control" @bind="_newPayment.Notes" />
                </div>
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-success" @onclick="SavePaymentAsync">تأكيد الدفعة</button>
                <button class="btn btn-outline-secondary" @onclick="() => _payingObligation = null">إلغاء</button>
            </div>
        </div>
    }

    <div class="fin-card mb-4">
        <h6 class="fw-bold mb-3">سجل الالتزامات (المستحق / المدفوع / المتبقي)</h6>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>النوع</th>
                        <th>البيان</th>
                        <th>الطرف</th>
                        <th>المستحق</th>
                        <th>المدفوع</th>
                        <th>المتبقي</th>
                        <th>الحالة</th>
                        <th>إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ob in _summary.Obligations)
                    {
                        <tr>
                            <td>@ob.Date.ToString("yyyy-MM-dd")</td>
                            <td>@ArabicDisplayHelper.GetObligationTypeLabel(ob.ObligationType)</td>
                            <td class="fw-semibold">@ob.Title</td>
                            <td>@ob.PartyName</td>
                            <td class="money-num">@ArabicDisplayHelper.FormatMoney(ob.TotalAmount, cur)</td>
                            <td class="money-num text-success">@ArabicDisplayHelper.FormatMoney(ob.PaidAmount, cur)</td>
                            <td class="money-num text-danger">@ArabicDisplayHelper.FormatMoney(ob.RemainingAmount, cur)</td>
                            <td>
                                <span class="badge @(ob.IsFullyPaid ? "badge-soft-success" : ob.PaidAmount > 0 ? "badge-soft-warning" : "badge-soft-danger")">
                                    @ob.StatusLabel
                                </span>
                            </td>
                            <td>
                                @if (!ob.IsFullyPaid)
                                {
                                    <button class="btn btn-sm btn-success" @onclick="() => StartPay(ob)">+ تسجيل دفعة</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="fin-card">
        <h6 class="fw-bold mb-3">سجل الدفعات النقدية والتحويلات</h6>
        <div class="table-responsive">
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th>تاريخ الدفع</th>
                        <th>النوع</th>
                        <th>طريقة الدفع</th>
                        <th>المبلغ</th>
                        <th>ملاحظات</th>
                        <th>إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in _payments)
                    {
                        <tr>
                            <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                            <td>@ArabicDisplayHelper.GetObligationTypeLabel(p.ObligationType)</td>
                            <td>@ArabicDisplayHelper.GetPaymentMethodLabel(p.Method)</td>
                            <td class="money-num text-success fw-bold">@ArabicDisplayHelper.FormatMoney(p.Amount, cur)</td>
                            <td>@p.Notes</td>
                            <td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePaymentAsync(p.Id)">حذف</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private ProjectFinancialSummary? _summary;
    private List<Payment> _payments = new();
    private ObligationSummary? _payingObligation;
    private Payment _newPayment = new();
    private string? _message;

    protected override async Task OnInitializedAsync()
    {
        ProjectState.OnChange += HandleProjectChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (!ProjectState.ActiveProjectId.HasValue) return;
        var pid = ProjectState.ActiveProjectId.Value;
        _summary = await CostService.GetProjectFinancialSummaryAsync(pid);
        _payments = await CostService.GetPaymentsAsync(pid);
    }

    private void StartPay(ObligationSummary ob)
    {
        _payingObligation = ob;
        _newPayment = new Payment
        {
            ProjectId = ProjectState.ActiveProjectId ?? 0,
            ObligationType = ob.ObligationType,
            ReferenceId = ob.ReferenceId,
            Amount = ob.RemainingAmount,
            PaymentDate = DateTime.Today,
            Method = PaymentMethod.Cash
        };
        _message = null;
    }

    private async Task SavePaymentAsync()
    {
        if (_newPayment.Amount <= 0) return;
        await CostService.RecordPaymentAsync(_newPayment);
        _payingObligation = null;
        _message = "تم تسجيل الدفعة بنجاح وتحديث الالتزامات المالية.";
        await LoadAsync();
    }

    private async Task DeletePaymentAsync(int id)
    {
        await CostService.SoftDeletePaymentAsync(id);
        await LoadAsync();
    }

    private async void HandleProjectChanged()
    {
        await LoadAsync();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ProjectState.OnChange -= HandleProjectChanged;
}
